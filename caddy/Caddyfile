# TLS termination for shopogs on the home network. The certificate comes from
# mkcert (local CA, the same one as for Crate and autoplay-pi on roon-bridge),
# hence auto_https off -- Caddy should not ask Let's Encrypt for anything,
# .local names cannot be certified there anyway.
#
# This Caddy runs on the project's Docker network and reaches shopogs by
# container name. That is why shopogs needs no published host port -- the
# public Caddy from konzert-guide reaches the same container over
# shared-proxy-net, likewise by name.
#
# Two separate Caddies on purpose, not one: this one terminates TLS with a
# mkcert certificate for extern.local on 5443, the public one holds the
# Let's Encrypt certificate for ichmussdieseplattehaben.rogzilla.eu on 443.
# Different certificate authorities, different lifecycles.
{
	auto_https off
	admin off
}

:5443 {
	# Access log. Caddy only writes it if it is explicitly switched on --
	# without this line there are no access lines, only operational
	# messages. The format is JSON, one line per request, with
	# request.remote_ip and status.
	#
	# Written for fail2ban. The move away from the Nginx Proxy Manager
	# happened on 04.08.2026 -- its filter matched "[Client <IP>]", which no
	# longer occurs anywhere. Caddy's JSON needs a filter of its own, and
	# that can only be developed against real lines.
	log
	tls /certs/extern-local.pem /certs/extern-local-key.pem
	reverse_proxy shopogs:80
}
